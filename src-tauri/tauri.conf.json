{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicMorph",
  "version": "0.1.0",
  "identifier": "com.micmorph.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MicMorph",
        "width": 540,
        "height": 680,
        "resizable": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
